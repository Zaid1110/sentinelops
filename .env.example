# Copy this file to .env and fill in your own values.
# Heuristic detection + dry-run Slack preview work WITHOUT any of these.

# For --mode ai (richer incident summaries via Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# For --notify (post the summary to Slack for real). Create one at
# https://api.slack.com/messaging/webhooks (Incoming Webhooks)
SLACK_WEBHOOK_URL=
